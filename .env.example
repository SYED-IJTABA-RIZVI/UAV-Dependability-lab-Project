POSTGRES_USER=uav
POSTGRES_PASSWORD=uav
POSTGRES_DB=uav

# Used by the app (app/db.py). Host/port must match docker-compose.yml.
# Host port is 5433 (not 5432) to avoid colliding with any other local Postgres.
DATABASE_URL=postgresql://uav:uav@localhost:5433/uav

# Qwen2.5-VL, via OpenRouter (the only one of the 4 VLMs with a hosted API —
# InternVL2.5/DeepSeek-VL/BLIP-2 run locally instead, see the "gpu" compose profile).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Everything below only matters when running `docker compose --profile gpu up`
# on a machine with an NVIDIA GPU (see SETUP.md). On a normal machine these
# are unused and the app just falls back to the mock simulator.
#
# YOLO checkpoints (place the .pt files in weights/ — see weights/.gitkeep):
#   weights/yolov12_rgb.pt  (YOLOv12, RGB)
#   weights/yolov10_ir.pt   (YOLOv10, IR/Thermal)
# Local VLM model ids are set directly in docker-compose.yml's vlm-* services.
