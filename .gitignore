# Python
__pycache__/
*.pyc
.venv/
venv/

# Model weights / checkpoints (large binaries, not meant for git)
*.pt
*.pth
*.onnx
*.ckpt

# Env / secrets
.env
*.env
.env.*
!.env.example

# `docker compose config` output — bakes in resolved secrets (API keys, etc.)
# and machine-specific absolute paths, never meant for git
compose-rendered.yml

# OS / editor
.DS_Store
.vscode/
.idea/

# Host folder mounted into the app container for FOLDER/TEST FOLDER inputs
data/*
!data/.gitkeep

# RFDETR checkpoints (*.pt already ignored above; this also covers any other
# file dropped here)
weights/*
!weights/.gitkeep
